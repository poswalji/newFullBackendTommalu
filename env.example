# ============================================
# Tommalu Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017/tommalu
# Optional: For testing
# MONGO_URI_TEST=mongodb://localhost:27017/tommalu_test
# MONGO_DB_NAME=tommalu

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Optional: Separate refresh token secret (if not provided, JWT_SECRET will be used)
# REFRESH_JWT_SECRET=your-refresh-token-secret
# Optional: Token expiration times
# JWT_EXPIRES_IN=30d
# REFRESH_JWT_EXPIRES_IN=30d

# ============================================
# Firebase Configuration
# ============================================
# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Option 1: Service Account Key (Recommended for production)
# Copy the entire JSON content from Firebase service account key file
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option 2: Individual Fields (Alternative to Option 1)
# Use this if you prefer individual environment variables instead of JSON
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# Cloudinary Configuration
# ============================================
# For image uploads and storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================
# Email Configuration
# ============================================
# Email service (default: gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================
# Logging Configuration
# ============================================
# Optional: Log level (default: info)
# LOG_LEVEL=info

# ============================================
# Deployment Configuration (Optional)
# ============================================
# For Vercel deployment
# VERCEL_URL=your-app.vercel.app

# For public API base URL (used in Swagger docs)
# PUBLIC_API_BASE_URL=https://api.tommalu.com

# ============================================
# Notes
# ============================================
# 1. Firebase Setup:
#    - Go to Firebase Console (https://console.firebase.google.com/)
#    - Create/select a project
#    - Enable Realtime Database
#    - Go to Project Settings > Service Accounts
#    - Generate a new private key (downloads JSON file)
#    - Copy JSON content to FIREBASE_SERVICE_ACCOUNT_KEY or extract individual fields
#
# 2. Cloudinary Setup:
#    - Sign up at https://cloudinary.com/
#    - Get your cloud name, API key, and API secret from the dashboard
#
# 3. Email Setup (Gmail):
#    - Enable 2-factor authentication
#    - Generate an app-specific password
#    - Use the app password in EMAIL_PASSWORD
#
# 4. Google OAuth Setup:
#    - Go to Google Cloud Console
#    - Create OAuth 2.0 credentials
#    - Add authorized redirect URIs
#    - Copy the Client ID
#
# 5. Security:
#    - Never commit .env file to version control
#    - Use strong, random values for JWT_SECRET
#    - Rotate secrets regularly in production
#    - Use environment-specific values for different deployments

